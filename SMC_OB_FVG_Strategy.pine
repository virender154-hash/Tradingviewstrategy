// ╔══════════════════════════════════════════════════════════════════╗
// ║     SMC Strategy: Order Block + FVG + Liquidity                 ║
// ║     Instruments: XAUUSD (Gold) & BTC                            ║
// ║     Logic:                                                       ║
// ║       1. Detect Bullish / Bearish Order Blocks                   ║
// ║       2. Mark Liquidity below support OB / above resistance OB   ║
// ║       3. Detect Bullish / Bearish Fair Value Gaps (FVG)          ║
// ║       4. Entry on OB or FVG retest                               ║
// ║       5. SL = Liquidity level                                    ║
// ║       6. TP  = Next Swing High (Long) / Next Swing Low (Short)   ║
// ╚══════════════════════════════════════════════════════════════════╝

//@version=5
strategy("SMC: OB + FVG | XAUUSD & BTC",
     overlay              = true,
     max_bars_back        = 500,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 1,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.05,
     slippage             = 2)

// ═══════════════════════════════════════════
//               INPUTS
// ═══════════════════════════════════════════
grpD = "Detection Settings"
i_swingLen   = input.int  (5,   "Swing Length (bars each side)", minval=2, maxval=20, group=grpD,
                           tooltip="Bars on each side to confirm a swing high/low pivot")
i_obLookback = input.int  (4,   "OB Lookback Bars",              minval=2, maxval=10, group=grpD,
                           tooltip="How many bars back to search for the OB candle before the impulse")

grpV = "Display"
i_showOB     = input.bool(true,  "Show Order Blocks",   group=grpV)
i_showFVG    = input.bool(true,  "Show FVG Zones",      group=grpV)
i_showLiq    = input.bool(true,  "Show Liquidity Lines", group=grpV)
i_showSwings = input.bool(true,  "Show Swing H/L",      group=grpV)

grpC = "Colors"
i_colBullOB  = input.color(color.new(color.lime,   75), "Bullish OB",   group=grpC)
i_colBearOB  = input.color(color.new(color.red,    75), "Bearish OB",   group=grpC)
i_colBullFVG = input.color(color.new(color.aqua,   80), "Bullish FVG",  group=grpC)
i_colBearFVG = input.color(color.new(color.orange, 80), "Bearish FVG",  group=grpC)
i_colSSL     = input.color(color.yellow,                "Sell-Side Liq (Long SL)",  group=grpC)
i_colBSL     = input.color(color.fuchsia,               "Buy-Side Liq (Short SL)",  group=grpC)

// ═══════════════════════════════════════════
//         SWING HIGH / LOW DETECTION
// ═══════════════════════════════════════════
swH = ta.pivothigh(high, i_swingLen, i_swingLen)
swL = ta.pivotlow (low,  i_swingLen, i_swingLen)

// Store up to 6 recent swing highs and lows (index 0 = most recent)
var float[] shArr = array.new_float(0)
var float[] slArr = array.new_float(0)

if not na(swH)
    array.unshift(shArr, swH)
    if array.size(shArr) > 6
        array.pop(shArr)

if not na(swL)
    array.unshift(slArr, swL)
    if array.size(slArr) > 6
        array.pop(slArr)

f_swH(n) => array.size(shArr) > n ? array.get(shArr, n) : na
f_swL(n) => array.size(slArr) > n ? array.get(slArr, n) : na

// Swing markers
if i_showSwings
    plotshape(not na(swH), "Swing High", shape.labeldown, location.abovebar,
             color.new(color.red, 40), text="H", textcolor=color.white,
             size=size.tiny, offset=-i_swingLen)
    plotshape(not na(swL), "Swing Low",  shape.labelup,   location.belowbar,
             color.new(color.teal, 40), text="L", textcolor=color.white,
             size=size.tiny, offset=-i_swingLen)

// ═══════════════════════════════════════════
//         ORDER BLOCK DETECTION
// ═══════════════════════════════════════════
// Bullish OB  → last BEARISH candle before a bullish impulse (becomes support)
// Bearish OB  → last BULLISH candle before a bearish impulse (becomes resistance)

isBullCandle = close > open
isBearCandle = close < open

// Impulse = two consecutive strong candles in same direction
bullImpulse = isBullCandle and isBullCandle[1] and high > high[1] and high[1] > high[2]
bearImpulse = isBearCandle and isBearCandle[1] and low  < low[1]  and low[1]  < low[2]

// ── Bullish OB State ──
var float bOB_hi   = na
var float bOB_lo   = na
var int   bOB_idx  = na
var bool  bOB_ok   = false
var bool  bOB_new  = false
var box   bOB_box  = na

// ── Bearish OB State ──
var float rOB_hi   = na
var float rOB_lo   = na
var int   rOB_idx  = na
var bool  rOB_ok   = false
var bool  rOB_new  = false
var box   rOB_box  = na

// Detect Bullish OB: search for last bearish candle before bullish impulse
if bullImpulse
    for i = 2 to i_obLookback + 2
        if isBearCandle[i]
            bOB_hi  := high[i]
            bOB_lo  := low[i]
            bOB_idx := bar_index[i]
            bOB_ok  := true
            bOB_new := true
            break

// Detect Bearish OB: search for last bullish candle before bearish impulse
if bearImpulse
    for i = 2 to i_obLookback + 2
        if isBullCandle[i]
            rOB_hi  := high[i]
            rOB_lo  := low[i]
            rOB_idx := bar_index[i]
            rOB_ok  := true
            rOB_new := true
            break

// Invalidate OB when price breaks through the zone
if bOB_ok and close < bOB_lo
    bOB_ok := false
    if not na(bOB_box)
        box.set_bgcolor      (bOB_box, color.new(color.lime, 93))
        box.set_border_color (bOB_box, color.new(color.lime, 60))

if rOB_ok and close > rOB_hi
    rOB_ok := false
    if not na(rOB_box)
        box.set_bgcolor      (rOB_box, color.new(color.red, 93))
        box.set_border_color (rOB_box, color.new(color.red, 60))

// Draw / update OB boxes
if bOB_new
    if i_showOB
        if not na(bOB_box)
            box.delete(bOB_box)
        bOB_box := box.new(bOB_idx, bOB_hi, bar_index, bOB_lo,
                         border_color = color.lime,
                         bgcolor      = i_colBullOB,
                         border_width = 2,
                         extend       = extend.right)
    bOB_new := false

if rOB_new
    if i_showOB
        if not na(rOB_box)
            box.delete(rOB_box)
        rOB_box := box.new(rOB_idx, rOB_hi, bar_index, rOB_lo,
                         border_color = color.red,
                         bgcolor      = i_colBearOB,
                         border_width = 2,
                         extend       = extend.right)
    rOB_new := false

// Extend active OB boxes to the right on every bar
if bOB_ok and not na(bOB_box)
    box.set_right(bOB_box, bar_index)
if rOB_ok and not na(rOB_box)
    box.set_right(rOB_box, bar_index)

// ═══════════════════════════════════════════
//         FAIR VALUE GAP (FVG)
// ═══════════════════════════════════════════
// Bullish FVG: current low > high 2 bars ago  → gap up  (becomes support)
// Bearish FVG: current high < low 2 bars ago  → gap down (becomes resistance)

bullFVG_det = low  > high[2]   // gap up
bearFVG_det = high < low[2]    // gap down

// ── Bullish FVG State ──
var float bFVG_top = na
var float bFVG_bot = na
var bool  bFVG_ok  = false
var box   bFVG_box = na

// ── Bearish FVG State ──
var float rFVG_top = na
var float rFVG_bot = na
var bool  rFVG_ok  = false
var box   rFVG_box = na

if bullFVG_det
    bFVG_top := low        // top of gap = current low
    bFVG_bot := high[2]    // bottom of gap = high 2 bars ago
    bFVG_ok  := true
    if i_showFVG
        if not na(bFVG_box)
            box.delete(bFVG_box)
        bFVG_box := box.new(bar_index - 2, bFVG_top, bar_index, bFVG_bot,
                          border_color = color.aqua,
                          bgcolor      = i_colBullFVG,
                          border_width = 1,
                          extend       = extend.right)

if bearFVG_det
    rFVG_top := low[2]     // top of gap = low 2 bars ago
    rFVG_bot := high       // bottom of gap = current high
    rFVG_ok  := true
    if i_showFVG
        if not na(rFVG_box)
            box.delete(rFVG_box)
        rFVG_box := box.new(bar_index - 2, rFVG_top, bar_index, rFVG_bot,
                          border_color = color.orange,
                          bgcolor      = i_colBearFVG,
                          border_width = 1,
                          extend       = extend.right)

// Invalidate FVG when fully filled
if bFVG_ok and close < bFVG_bot
    bFVG_ok := false

if rFVG_ok and close > rFVG_top
    rFVG_ok := false

// Extend FVG boxes
if i_showFVG
    if bFVG_ok and not na(bFVG_box)
        box.set_right(bFVG_box, bar_index)
    if rFVG_ok and not na(rFVG_box)
        box.set_right(rFVG_box, bar_index)

// ═══════════════════════════════════════════
//         LIQUIDITY DETECTION
// ═══════════════════════════════════════════
// Bullish OB (support)    → Sell-Side Liquidity BELOW  = swing lows below OB  → Long SL
// Bearish OB (resistance) → Buy-Side  Liquidity ABOVE  = swing highs above OB → Short SL

var float liqSSL = na   // Sell-Side Liquidity (below support OB)  = SL for Long
var float liqBSL = na   // Buy-Side  Liquidity (above resist OB)   = SL for Short

var line  liqSSL_line = na
var line  liqBSL_line = na
var label liqSSL_lbl  = na
var label liqBSL_lbl  = na

// Update SSL: nearest swing low below bullish OB
if bOB_ok
    for i = 0 to array.size(slArr) - 1
        lvl = f_swL(i)
        if not na(lvl) and lvl < bOB_lo
            liqSSL := lvl
            break
else
    liqSSL := na

// Update BSL: nearest swing high above bearish OB
if rOB_ok
    for i = 0 to array.size(shArr) - 1
        lvl = f_swH(i)
        if not na(lvl) and lvl > rOB_hi
            liqBSL := lvl
            break
else
    liqBSL := na

// Draw liquidity lines (refresh on last bar only to avoid clutter)
if i_showLiq and barstate.islast
    if not na(liqSSL)
        if not na(liqSSL_line)
            line.delete(liqSSL_line)
        if not na(liqSSL_lbl)
            label.delete(liqSSL_lbl)
        liqSSL_line := line.new(bar_index - 80, liqSSL, bar_index + 15, liqSSL,
                               color=i_colSSL, style=line.style_dashed, width=2)
        liqSSL_lbl  := label.new(bar_index + 16, liqSSL, "SSL  (Long SL)",
                                color=i_colSSL, textcolor=color.black,
                                style=label.style_label_left, size=size.small)

    if not na(liqBSL)
        if not na(liqBSL_line)
            line.delete(liqBSL_line)
        if not na(liqBSL_lbl)
            label.delete(liqBSL_lbl)
        liqBSL_line := line.new(bar_index - 80, liqBSL, bar_index + 15, liqBSL,
                               color=i_colBSL, style=line.style_dashed, width=2)
        liqBSL_lbl  := label.new(bar_index + 16, liqBSL, "BSL  (Short SL)",
                                color=i_colBSL, textcolor=color.black,
                                style=label.style_label_left, size=size.small)

// ═══════════════════════════════════════════
//         ENTRY CONDITIONS
// ═══════════════════════════════════════════
// Long  → price retests Bullish OB zone  OR  Bullish FVG zone
// Short → price retests Bearish OB zone  OR  Bearish FVG zone

touchBullOB  = bOB_ok  and low  <= bOB_hi  and close >= bOB_lo
touchBullFVG = bFVG_ok and low  <= bFVG_top and close >= bFVG_bot
longEntry    = (touchBullOB or touchBullFVG) and barstate.isconfirmed and strategy.position_size == 0

touchBearOB  = rOB_ok  and high >= rOB_lo  and close <= rOB_hi
touchBearFVG = rFVG_ok and high >= rFVG_bot and close <= rFVG_top
shortEntry   = (touchBearOB or touchBearFVG) and barstate.isconfirmed and strategy.position_size == 0

// ═══════════════════════════════════════════
//      STOP LOSS & TAKE PROFIT
// ═══════════════════════════════════════════
// ── Long Trade ──
//   SL  = SSL level (sell-side liquidity below OB),  fallback = below OB low
//   TP  = nearest swing high above current close,    fallback = 1.5R

longSL = not na(liqSSL) ? liqSSL - syminfo.mintick * 3 :
         not na(bOB_lo)  ? bOB_lo  - (bOB_hi - bOB_lo) * 0.1 : na

longTP = na(float)
for i = 0 to array.size(shArr) - 1
    h = f_swH(i)
    if not na(h) and h > close * 1.002
        longTP := h
        break
if na(longTP) and not na(longSL)
    longTP := close + (close - longSL) * 1.5

// ── Short Trade ──
//   SL  = BSL level (buy-side liquidity above OB),   fallback = above OB high
//   TP  = nearest swing low below current close,      fallback = 1.5R

shortSL = not na(liqBSL) ? liqBSL + syminfo.mintick * 3 :
          not na(rOB_hi)  ? rOB_hi  + (rOB_hi - rOB_lo) * 0.1 : na

shortTP = na(float)
for i = 0 to array.size(slArr) - 1
    l = f_swL(i)
    if not na(l) and l < close * 0.998
        shortTP := l
        break
if na(shortTP) and not na(shortSL)
    shortTP := close - (shortSL - close) * 1.5

// ═══════════════════════════════════════════
//         STRATEGY EXECUTION
// ═══════════════════════════════════════════
if longEntry and not na(longSL) and not na(longTP) and longTP > close and longSL < close
    strategy.entry("Long", strategy.long, comment="Long @ OB/FVG")
    strategy.exit ("Long Exit", "Long", stop=longSL, limit=longTP)

if shortEntry and not na(shortSL) and not na(shortTP) and shortTP < close and shortSL > close
    strategy.entry("Short", strategy.short, comment="Short @ OB/FVG")
    strategy.exit ("Short Exit", "Short", stop=shortSL, limit=shortTP)

// ═══════════════════════════════════════════
//         ENTRY SIGNAL MARKERS
// ═══════════════════════════════════════════
plotshape(longEntry,  "Long Entry",  shape.triangleup,   location.belowbar,
         color.lime, size=size.normal)
plotshape(shortEntry, "Short Entry", shape.triangledown, location.abovebar,
         color.red,  size=size.normal)

// ═══════════════════════════════════════════
//         INFORMATION TABLE
// ═══════════════════════════════════════════
var table infoT = table.new(position.top_right, 2, 8,
                            bgcolor      = color.new(color.black, 55),
                            border_color = color.new(color.gray, 30),
                            border_width = 1,
                            frame_color  = color.new(color.gray, 30),
                            frame_width  = 1)

if barstate.islast
    // Header
    table.cell(infoT, 0, 0, "SMC Strategy | OB + FVG",
               text_color=color.white, text_size=size.small,
               bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.merge_cells(infoT, 0, 0, 1, 0)

    // Bull OB
    table.cell(infoT, 0, 1, "Bullish OB",   text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 1, bOB_ok ? "Active  " + str.tostring(math.round(bOB_lo, 2)) + " – " + str.tostring(math.round(bOB_hi, 2)) : "—",
               text_color=bOB_ok ? color.lime : color.gray, text_size=size.small)

    // Bear OB
    table.cell(infoT, 0, 2, "Bearish OB",   text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 2, rOB_ok ? "Active  " + str.tostring(math.round(rOB_lo, 2)) + " – " + str.tostring(math.round(rOB_hi, 2)) : "—",
               text_color=rOB_ok ? color.red : color.gray, text_size=size.small)

    // Bull FVG
    table.cell(infoT, 0, 3, "Bullish FVG",  text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 3, bFVG_ok ? "Active  " + str.tostring(math.round(bFVG_bot, 2)) + " – " + str.tostring(math.round(bFVG_top, 2)) : "—",
               text_color=bFVG_ok ? color.aqua : color.gray, text_size=size.small)

    // Bear FVG
    table.cell(infoT, 0, 4, "Bearish FVG",  text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 4, rFVG_ok ? "Active  " + str.tostring(math.round(rFVG_bot, 2)) + " – " + str.tostring(math.round(rFVG_top, 2)) : "—",
               text_color=rFVG_ok ? color.orange : color.gray, text_size=size.small)

    // SSL
    table.cell(infoT, 0, 5, "SSL (Long SL)",  text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 5, not na(liqSSL) ? str.tostring(math.round(liqSSL, 2)) : "—",
               text_color=not na(liqSSL) ? color.yellow : color.gray, text_size=size.small)

    // BSL
    table.cell(infoT, 0, 6, "BSL (Short SL)", text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 6, not na(liqBSL) ? str.tostring(math.round(liqBSL, 2)) : "—",
               text_color=not na(liqBSL) ? color.fuchsia : color.gray, text_size=size.small)

    // Position
    posStr   = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "Flat"
    posColor = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoT, 0, 7, "Position",       text_color=color.silver, text_size=size.small)
    table.cell(infoT, 1, 7, posStr,           text_color=posColor,     text_size=size.small)
